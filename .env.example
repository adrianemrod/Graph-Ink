# ─── Site ───────────────────────────────────────────────
# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.ph

# ─── Analytics (optional — leave empty to disable) ──────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Quote & contact delivery ───────────────────────────
# One of: resend | webhook | formspree | log
# In production, if unset, the forms show a friendly "not connected yet"
# message instead of silently losing requests. `log` prints to server logs.
QUOTE_PROVIDER=

# Resend (https://resend.com)
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=

# Generic webhook (Zapier, Make, n8n, Supabase Edge Function, your backend)
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_SECRET=

# Formspree (file attachments are not forwarded — names + links only)
FORMSPREE_FORM_ID=
