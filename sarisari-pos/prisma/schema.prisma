// KUYA JE SARISARI STORE — database schema
// Money is always Decimal(12,2). Never floats.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  CASHIER
}

enum PaymentMethod {
  CASH
  GCASH
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

enum MovementType {
  SALE
  STOCK_IN
  ADJUSTMENT
}

enum GcashType {
  CASH_IN
  CASH_OUT
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  sales     Sale[]
  movements InventoryMovement[]
  expenses  Expense[]
  gcash     GcashTransaction[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  isSample  Boolean   @default(false)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id            String   @id @default(cuid())
  name          String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  costPrice     Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  stock         Int      @default(0)
  lowStockLevel Int      @default(5)
  sku           String?  @unique
  barcode       String?  @unique
  archived      Boolean  @default(false)
  isSample      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  saleItems SaleItem[]
  movements InventoryMovement[]

  @@index([archived, name])
}

model Sale {
  id              String        @id @default(cuid())
  receiptNo       Int           @unique @default(autoincrement())
  // Generated by the browser for each checkout. Prevents duplicate sales from double clicks.
  clientRequestId String        @unique
  subtotal        Decimal       @db.Decimal(12, 2)
  discountType    DiscountType  @default(NONE)
  discountValue   Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  costTotal       Decimal       @db.Decimal(12, 2)
  grossProfit     Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  amountReceived  Decimal       @db.Decimal(12, 2)
  change          Decimal       @default(0) @db.Decimal(12, 2)
  cashierId       String
  cashier         User          @relation(fields: [cashierId], references: [id])
  isSample        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  items     SaleItem[]
  movements InventoryMovement[]

  @@index([createdAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  // Snapshot of the name and prices at the time of sale.
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  unitCost    Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  lineCost    Decimal @db.Decimal(12, 2)
}

model InventoryMovement {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  type        MovementType
  // Signed: +20 for stock added, -2 for a sale, -1 for a damaged item.
  quantity    Int
  stockBefore Int
  stockAfter  Int
  // For adjustments: Damaged, Expired, Lost, Manual Correction
  reason      String?
  notes       String?
  saleId      String?
  sale        Sale?        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  isSample    Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id          String          @id @default(cuid())
  name        String
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Decimal         @db.Decimal(12, 2)
  // The day the expense happened (stored as the start of that day in Asia/Manila).
  spentAt     DateTime
  notes       String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  isSample    Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([spentAt])
}

// GCash cash-in / cash-out SERVICE. Never mixed with product sales.
model GcashTransaction {
  id                String    @id @default(cuid())
  type              GcashType
  amount            Decimal   @db.Decimal(12, 2)
  serviceFee        Decimal   @default(0) @db.Decimal(12, 2)
  customerReference String?
  notes             String?
  clientRequestId   String    @unique
  createdById       String
  createdBy         User      @relation(fields: [createdById], references: [id])
  isSample          Boolean   @default(false)
  createdAt         DateTime  @default(now())

  @@index([createdAt])
}

model StoreSettings {
  id                   Int      @id @default(1)
  storeName            String   @default("KUYA JE SARISARI STORE")
  storeAddress         String   @default("")
  contactNumber        String   @default("")
  startingGcashBalance Decimal  @default(0) @db.Decimal(12, 2)
  receiptFooter        String   @default("Thank you! Come again.")
  updatedAt            DateTime @updatedAt
}
